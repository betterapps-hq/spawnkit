{
  "name": "@spawnkit/cli",
  "version": "0.1.0",
  "description": "Create, extend, and publish standalone browser games with SpawnKit",
  "license": "UNLICENSED",
  "homepage": "https://spawnkit.cloud/docs/cli",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "bin": {
    "spawn": "./dist/main.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "vite build",
    "check:types": "tsc --noEmit",
    "lint": "oxlint --max-warnings=0 src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@clack/prompts": "1.8.1",
    "@spawn/templates": "workspace:*",
    "picocolors": "^1.1.1",
    "@spawn/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
