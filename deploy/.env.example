# Copy to .env.github.production, .env.github.staging, or .env.github.local.
# Use a separate GitHub App for each environment, then enable it in github.json.
# Social sign-in OAuth credentials belong in Clerk, not in this file.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Paste the entire PEM inside these quotes, preserving its line breaks.
GITHUB_APP_PRIVATE_KEY=""
