{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "trailingComma": "none",
  "sortImports": { "enabled": true, "newlinesBetween": false, "sortSpecifiers": true },
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/docs/**",
    "**/routeTree.gen.ts",
    "pnpm-lock.yaml",
    "packages/telemetry/scaffold.js",
    "work/**",
    "playwright-report/**",
    "test-results/**"
  ]
}
