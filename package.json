{
  "name": "spawn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0 <13.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "dev-domains run app",
    "cli": "tsx scripts/cli-dev.ts",
    "format": "oxfmt",
    "check:format": "oxfmt --check",
    "check:lint": "turbo run lint",
    "check:types": "turbo run check:types",
    "check:unused": "knip",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:config": "node --test scripts/github-config.test.mjs scripts/preview-config.test.mjs apps/control-api/optimize-cover.test.mjs apps/control-api/optimize-trailer.test.mjs apps/control-api/optimize-game-images.test.mjs && tsx --test scripts/template-cases.test.mjs",
    "test:e2e": "playwright test",
    "test:templates": "pnpm --filter @spawnkit/cli build && tsx scripts/smoke-templates.mjs",
    "test:telemetry-package": "node scripts/smoke-telemetry.mjs",
    "test:cli-package": "node scripts/smoke-cli-package.mjs",
    "verify": "run-s check:format check:lint check:types check:unused test:config test:coverage build",
    "seo:audit": "node scripts/audit-seo.mjs",
    "seo:creators": "tsx scripts/audit-creator-metrics.ts",
    "seo:field": "node scripts/audit-seo-field.mjs",
    "seo:performance": "node scripts/audit-seo-performance.mjs",
    "seo:builder-performance": "node scripts/audit-builder-startup.mjs",
    "images:templates": "node scripts/optimize-template-images.mjs",
    "hooks:install": "lefthook install",
    "storybook": "dev-domains run stories",
    "build:storybook": "pnpm --filter @spawn/dashboard build:storybook",
    "deploy": "node scripts/deploy.mjs",
    "dev:setup": "dev-domains setup",
    "dev:urls": "dev-domains urls",
    "dev:status": "dev-domains status",
    "dev:doctor": "dev-domains doctor",
    "dev:api": "dev-domains run api",
    "dev:telemetry": "dev-domains run telemetry",
    "dev:database": "node scripts/dev.mjs database",
    "dev:register": "node scripts/dev.mjs register",
    "dev:hooks:setup": "node scripts/webhooks.mjs setup",
    "dev:hooks": "node scripts/webhooks.mjs run",
    "dev:hooks:status": "node scripts/webhooks.mjs status"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "npm-run-all2": "9.0.3",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "@buildkitgg/dev-domains": "0.1.0",
    "@buildkitgg/scaffolder": "catalog:",
    "@spawn/templates": "workspace:*",
    "tsx": "4.23.15",
    "turbo": "2.11.8",
    "vite": "catalog:"
  }
}
